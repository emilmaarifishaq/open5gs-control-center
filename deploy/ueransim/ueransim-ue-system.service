[Unit]
Description=UERANSIM User Equipment in isolated namespace
After=ueransim-gnb.service
Requires=ueransim-gnb.service

[Service]
Type=simple
User=root
WorkingDirectory=/home/papibarra/UERANSIM
ExecStart=/usr/sbin/ip netns exec ueransim /home/papibarra/UERANSIM/build/nr-ue -c /home/papibarra/UERANSIM/config/open5gs-ue.yaml
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
